{
  "name": "vibe-stack-supabase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "op run --env-file=.env.op -- next dev --turbopack || next dev --turbopack",
    "sync:moomoo": "op run --env-file=.env.op -- npx tsx scripts/sync_moomoo.ts || echo 'op missing, sync skipped'",
    "build:local": "npm run sync:moomoo && op run --env-file=.env.op -- next build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/ws": "^8.18.1",
    "date-fns": "^4.4.0",
    "futu-api": "^10.9.6908",
    "lucide-react": "^1.27.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.1.30"
}
